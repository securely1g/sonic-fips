"""Prepare the exact OpenSSL source and patch order used by rules/openssl.mk."""

def _openssl_source_impl(ctx):
    ctx.download_and_extract(
        url = "https://deb.debian.org/debian/pool/main/o/openssl/openssl_3.5.7.orig.tar.gz",
        sha256 = "a8c0d28a529ca480f9f36cf5792e2cd21984552a3c8e4aa11a24aa31aeac98e8",
        stripPrefix = "openssl-3.5.7",
    )
    ctx.download_and_extract(
        url = "https://deb.debian.org/debian/pool/main/o/openssl/openssl_3.5.7-1~deb13u2.debian.tar.xz",
        sha256 = "593a47654ead460a3b609503733f80bef552ff0802799d3b47784faacc50809f",
    )

    # Make applies the SONiC series before dpkg applies Debian's source series.
    for patch in ctx.attr.sonic_patches:
        ctx.patch(patch, strip = 1)
    for line in ctx.read("debian/patches/series").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if " " in line or "\t" in line:
            fail("Unexpected Debian patch options: " + line)
        ctx.patch(ctx.path("debian/patches/" + line), strip = 1)
    for patch in ctx.attr.test_patches:
        ctx.patch(patch, strip = 1)
    ctx.file("BUILD.bazel", """# AUTO-GENERATED by sonic-fips //openssl:sources.bzl. DO NOT EDIT.
exports_files(["LICENSE.txt"] + glob(["debian/**"]))
filegroup(
    name = "sources",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
    visibility = ["//visibility:public"],
)
""")

openssl_source = repository_rule(
    implementation = _openssl_source_impl,
    attrs = {
        "sonic_patches": attr.label_list(default = [
            "//src/openssl.patch:20-support-fips-mode.patch",
            "//src/openssl.patch:30-load-symcrypt-engine-provider.patch",
        ]),
        "test_patches": attr.label_list(default = [
            "//src/openssl.patch:debian.patch/20-support-fips-test.patch",
            "//src/openssl.patch:debian.patch/40-disable-test-cases-with-fips-enabled.patch",
            "//src/openssl.patch:debian.patch/70-disable-evp-iv-check.patch",
            "//src/openssl.patch:debian.patch/fix-test-Check-CMS-failure-during-BIO-setup-with-stream-is-handled.patch",
        ]),
    },
)
