load("@rules_gzip//gzip/compress:defs.bzl", "gzip_compress")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@sonic_build_infra//deb:metadata.bzl", "debian_library", "debian_metadata")
load("@sonic_build_infra//deb:sonic_deb.bzl", "sonic_deb")
load("@sonic_build_infra//deb:validation.bzl", "validate_debian_package")
load("@tar.bzl", "tar")

package(default_visibility = ["//visibility:public"])

_VERSION = "3.5.7-1~deb13u2+fips"

_PACKAGES = {
    "libssl3t64": "//openssl:libssl3t64_pkg",
    "openssl": "//openssl:openssl_pkg",
    "libssl-dev": "//openssl:libssl_dev_pkg",
}

# Make appends +fips to this same Debian source version before packaging.
genrule(
    name = "changelog",
    srcs = ["@openssl_src//:debian/changelog"],
    outs = ["changelog.Debian"],
    cmd = "sed '1s/(3.5.7-1~deb13u2)/(3.5.7-1~deb13u2+fips)/' $(location @openssl_src//:debian/changelog) > $@",
)

gzip_compress(
    name = "changelog_gzip",
    src = ":changelog",
    level = 9,
)

[
    tar(
        name = package + "_documentation",
        srcs = [":changelog_gzip"],
        mtree = [
            "usr/share/doc/" + package + " uid=0 gid=0 mode=0755 type=dir",
            "usr/share/doc/" + package + "/changelog.Debian.gz uid=0 gid=0 mode=0644 type=file content=$(location :changelog_gzip)",
        ],
    )
    for package in _PACKAGES
]

[
    pkg_tar(
        name = package + "_data",
        deps = [
            runtime,
            ":" + package + "_documentation",
        ],
    )
    for package, runtime in _PACKAGES.items()
]

_PREPARE = """
set -eu
export DEB_HOST_ARCH=@ARCH@
/bin/bash $(location prepare.sh) \
  "$(BSDTAR_BIN)" \
  "$(execpath @sonic_build_infra//tools/build_tools:dh_makeshlibs)" \
  "$(execpath @sonic_build_infra//tools/build_tools:dh_perl)" \
  "$(execpath @sonic_build_infra//tools/build_tools:dh_installdeb)" \
  "$(location @openssl_src//:debian/control)" \
  "$(location :changelog)" \
  "$(location @openssl_src//:debian/libssl3t64.symbols)" \
  "$(location @openssl_src//:debian/openssl.postinst)" \
  "$(location :libssl3t64_data)" "$(location :openssl_data)" "$(location :libssl-dev_data)" \
  "$(@D)"
"""

# Run Debian's own helpers against the already-built package payloads. This
# generates the real conffile list, Perl dependency, ldconfig trigger and
# maintainer-script expansion without recompiling OpenSSL or building a DEB.
genrule(
    name = "installation_metadata",
    srcs = [
        "prepare.sh",
        ":changelog",
        "@openssl_src//:debian/control",
        "@openssl_src//:debian/libssl3t64.symbols",
        "@openssl_src//:debian/openssl.postinst",
    ] + [":" + package + "_data" for package in _PACKAGES],
    outs = [
        "libssl3t64.symbols",
        "libssl3t64.shlibs",
        "libssl3t64.triggers",
        "libssl3t64.substvars",
        "openssl.postinst",
        "openssl.conffiles",
        "openssl.substvars",
        "libssl-dev.substvars",
    ],
    cmd = select({
        "@platforms//cpu:x86_64": _PREPARE.replace("@ARCH@", "amd64"),
        "@platforms//cpu:aarch64": _PREPARE.replace("@ARCH@", "arm64"),
    }),
    toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
    tools = [
        "@sonic_build_infra//tools/build_tools:dh_installdeb",
        "@sonic_build_infra//tools/build_tools:dh_makeshlibs",
        "@sonic_build_infra//tools/build_tools:dh_perl",
    ],
)

[
    debian_library(
        name = package + "_library",
        control_tar = "@openssl_package_deps//" + package + ":control",
        data = "@openssl_package_deps//" + package + ":data",
    )
    for package in [
        "libc6",
        "libzstd1",
        "zlib1g",
    ]
]

debian_library(
    name = "libssl3t64_library",
    data = ":libssl3t64_data",
    shlibs = ":libssl3t64.shlibs",
    symbols = ":libssl3t64.symbols",
)

[
    debian_metadata(
        name = package + "_metadata",
        changelog = ":changelog",
        control = "@openssl_src//:debian/control",
        data = ":" + package + "_data",
        dependencies = [
            ":libssl3t64_library",
            ":libc6_library",
            ":libzstd1_library",
            ":zlib1g_library",
        ],
        package = package,
        substvars = ":" + package + ".substvars",
        version = _VERSION,
    )
    for package in _PACKAGES
]

[
    sonic_deb(
        name = package.replace("-", "_") + "_deb",
        control_file = ":" + package + "_metadata",
        control_files = {
            ":libssl3t64.symbols": "symbols",
            ":libssl3t64.shlibs": "shlibs",
            ":libssl3t64.triggers": "triggers",
        } if package == "libssl3t64" else {
            ":openssl.postinst": "postinst",
            ":openssl.conffiles": "conffiles",
        } if package == "openssl" else {},
        data = ":" + package + "_data",
        package = package,
        tags = ["manual"],
        version = _VERSION,
    )
    for package in _PACKAGES
]

[validate_debian_package(
    name = package + "_validation",
    control = ":" + package + "_metadata",
    control_files = {
        ":libssl3t64.symbols": "symbols",
        ":libssl3t64.shlibs": "shlibs",
        ":libssl3t64.triggers": "triggers",
    } if package == "libssl3t64" else {
        ":openssl.postinst": "postinst",
        ":openssl.conffiles": "conffiles",
    } if package == "openssl" else {},
    data = ":" + package + "_data",
    deb = ":" + package.replace("-", "_") + "_deb",
    package = package,
    tags = ["manual"],
    version = _VERSION,
) for package in _PACKAGES]

filegroup(
    name = "package_validation",
    srcs = [":" + package + "_validation" for package in _PACKAGES],
    tags = ["manual"],
)
