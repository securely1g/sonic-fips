load("@rules_gzip//gzip/compress:defs.bzl", "gzip_compress")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@sonic_build_infra//deb:metadata.bzl", "debian_library", "debian_metadata")
load("@sonic_build_infra//deb:sonic_deb.bzl", "sonic_deb")
load("@sonic_build_infra//deb:validation.bzl", "validate_debian_package")
load("@tar.bzl", "tar")

package(default_visibility = ["//visibility:public"])

_VERSION = "1:10.0p1-7+fips"

_LIBRARIES = [
    "libc6",
    "libedit2",
    "libfido2-1",
    "libselinux1",
    "libcbor0.10",
    "libcrypt1",
    "libgssapi-krb5-2",
    "libkrb5-3",
    "libk5crypto3",
    "libkrb5support0",
    "libcom-err2",
    "libkeyutils1",
    "libudev1",
    "zlib1g",
    "libzstd1",
    "libpcre2-8-0",
    "libtinfo6",
    "libgcc-s1",
]

genrule(
    name = "changelog",
    srcs = ["@openssh_src//:debian/changelog"],
    outs = ["changelog.Debian"],
    cmd = "sed '1s/(1:10.0p1-7)/(1:10.0p1-7+fips)/' $(location @openssh_src//:debian/changelog) > $@",
)

gzip_compress(
    name = "changelog_gzip",
    src = ":changelog",
    level = 9,
)

tar(
    name = "debian_files",
    srcs = [
        ":changelog_gzip",
        "@openssh_src//:debian/openssh-client.tmpfiles",
    ],
    mtree = [
        "usr/share/doc/openssh-client uid=0 gid=0 mode=0755 type=dir",
        "usr/share/doc/openssh-client/changelog.Debian.gz uid=0 gid=0 mode=0644 type=file content=$(location :changelog_gzip)",
        "usr/lib/tmpfiles.d uid=0 gid=0 mode=0755 type=dir",
        "usr/lib/tmpfiles.d/openssh-client.conf uid=0 gid=0 mode=0644 type=file content=$(location @openssh_src//:debian/openssh-client.tmpfiles)",
    ],
)

pkg_tar(
    name = "package_data",
    deps = [
        ":debian_files",
        "//openssh:openssh_client_pkg",
    ],
)

_PREPARE = """
set -eu
export DEB_HOST_ARCH=@ARCH@
/bin/bash $(location prepare.sh) "$(BSDTAR_BIN)" \
  "$(execpath @sonic_build_infra//tools/build_tools:dh_installdeb)" \
  "$(execpath @sonic_build_infra//tools/build_tools:dh_installsystemduser)" \
  "$(execpath @sonic_build_infra//tools/build_tools:dh_installtmpfiles)" \
  "$(location @openssh_src//:debian/control)" "$(location :changelog)" \
  "$(location :package_data)" "$(@D)"
"""

genrule(
    name = "installation_metadata",
    srcs = [
        "prepare.sh",
        ":changelog",
        ":package_data",
        "@openssh_src//:debian/control",
    ] + [
        "@openssh_src//:debian/openssh-client." + member
        for member in [
            "postinst",
            "postrm",
            "maintscript",
            "tmpfiles",
        ]
    ],
    outs = ["openssh-client." + member for member in [
        "preinst",
        "postinst",
        "prerm",
        "postrm",
        "conffiles",
        "substvars",
    ]],
    cmd = select({
        "@platforms//cpu:x86_64": _PREPARE.replace("@ARCH@", "amd64"),
        "@platforms//cpu:aarch64": _PREPARE.replace("@ARCH@", "arm64"),
    }),
    toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
    tools = ["@sonic_build_infra//tools/build_tools:" + name for name in [
        "dh_installdeb",
        "dh_installsystemduser",
        "dh_installtmpfiles",
    ]],
)

[debian_library(
    name = package + "_library",
    control_tar = "@openssh_package_deps//" + package + ":control",
    data = "@openssh_package_deps//" + package + ":data",
) for package in _LIBRARIES]

debian_metadata(
    name = "metadata",
    changelog = ":changelog",
    control = "@openssh_src//:debian/control",
    data = ":package_data",
    dependencies = [":" + name + "_library" for name in _LIBRARIES] + ["//openssl/debian:libssl3t64_library"],
    package = "openssh-client",
    substvars = ":openssh-client.substvars",
    version = _VERSION,
)

sonic_deb(
    name = "openssh_client_deb",
    control_file = ":metadata",
    control_files = {":openssh-client." + member: member for member in [
        "preinst",
        "postinst",
        "prerm",
        "postrm",
        "conffiles",
    ]},
    data = ":package_data",
    package = "openssh-client",
    tags = ["manual"],
    version = _VERSION,
)

validate_debian_package(
    name = "package_validation",
    control = ":metadata",
    control_files = {":openssh-client." + member: member for member in [
        "preinst",
        "postinst",
        "prerm",
        "postrm",
        "conffiles",
    ]},
    data = ":package_data",
    deb = ":openssh_client_deb",
    package = "openssh-client",
    tags = ["manual"],
    version = _VERSION,
)
