load("@rules_gzip//gzip/compress:defs.bzl", "gzip_compress")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@sonic_build_infra//deb:metadata.bzl", "debian_library", "debian_metadata")
load("@sonic_build_infra//deb:sonic_deb.bzl", "sonic_deb")
load("@sonic_build_infra//deb:validation.bzl", "validate_debian_package")
load("@tar.bzl", "tar")

package(default_visibility = ["//visibility:public"])

_VERSION = "1.21.3-5+fips"

_PACKAGES = [
    "libgssapi-krb5-2",
    "libk5crypto3",
    "libkrb5-3",
    "libkrb5support0",
]

genrule(
    name = "changelog",
    srcs = ["@krb5_src//:debian/changelog"],
    outs = ["changelog.Debian"],
    cmd = "sed '1s/(1.21.3-5)/(1.21.3-5+fips)/' $(location @krb5_src//:debian/changelog) > $@",
)

gzip_compress(
    name = "changelog_gzip",
    src = ":changelog",
    level = 9,
)

[tar(
    name = package + "_documentation",
    srcs = [":changelog_gzip"],
    mtree = [
        "usr/share/doc/" + package + " uid=0 gid=0 mode=0755 type=dir",
        "usr/share/doc/" + package + "/changelog.Debian.gz uid=0 gid=0 mode=0644 type=file content=$(location :changelog_gzip)",
    ],
) for package in _PACKAGES]

[pkg_tar(
    name = package + "_data",
    deps = [
        "//krb5:" + package.replace("-", "_") + "_pkg",
        ":" + package + "_documentation",
    ],
) for package in _PACKAGES]

_PREPARE = """
set -eu
export DEB_HOST_ARCH=@ARCH@
/bin/bash $(location prepare.sh) "$(BSDTAR_BIN)" \
  "$(execpath @sonic_build_infra//tools/build_tools:dh_makeshlibs)" \
  "$(execpath @sonic_build_infra//tools/build_tools:dh_installdeb)" \
  "$(location @krb5_src//:debian/control)" "$(location :changelog)" "$(@D)" \
""" + " ".join(["\"$(location :" + package + "_data)\"" for package in _PACKAGES])

genrule(
    name = "installation_metadata",
    srcs = [
        "prepare.sh",
        ":changelog",
        "@krb5_src//:debian/control",
        "@krb5_src//:debian/libgssapi-krb5-2.postinst",
        "@krb5_src//:debian/libgssapi-krb5-2.postrm",
    ] + [
        "@krb5_src//:debian/" + package + ".symbols"
        for package in _PACKAGES
    ] + [":" + package + "_data" for package in _PACKAGES],
    outs = [package + "." + member for package in _PACKAGES for member in [
        "symbols",
        "shlibs",
        "triggers",
        "substvars",
    ]] + [
        "libgssapi-krb5-2.postinst",
        "libgssapi-krb5-2.postrm",
    ],
    cmd = select({
        "@platforms//cpu:x86_64": _PREPARE.replace("@ARCH@", "amd64"),
        "@platforms//cpu:aarch64": _PREPARE.replace("@ARCH@", "arm64"),
    }),
    toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
    tools = [
        "@sonic_build_infra//tools/build_tools:dh_installdeb",
        "@sonic_build_infra//tools/build_tools:dh_makeshlibs",
    ],
)

[debian_library(
    name = package + "_library",
    control_tar = "@krb5_package_deps//" + package + ":control",
    data = "@krb5_package_deps//" + package + ":data",
) for package in [
    "libc6",
    "libcom-err2",
    "libkeyutils1",
]]

[debian_library(
    name = package + "_library",
    data = ":" + package + "_data",
    shlibs = ":" + package + ".shlibs",
    symbols = ":" + package + ".symbols",
) for package in _PACKAGES]

[debian_metadata(
    name = package + "_metadata",
    changelog = ":changelog",
    control = "@krb5_src//:debian/control",
    data = ":" + package + "_data",
    dependencies = [":" + name + "_library" for name in _PACKAGES + [
        "libc6",
        "libcom-err2",
        "libkeyutils1",
    ]] + ["//openssl/debian:libssl3t64_library"],
    package = package,
    substvars = ":" + package + ".substvars",
    version = _VERSION,
) for package in _PACKAGES]

[sonic_deb(
    name = package.replace("-", "_") + "_deb",
    control_file = ":" + package + "_metadata",
    control_files = {":" + package + "." + member: member for member in [
        "symbols",
        "shlibs",
        "triggers",
    ]} | ({
        ":libgssapi-krb5-2.postinst": "postinst",
        ":libgssapi-krb5-2.postrm": "postrm",
    } if package == "libgssapi-krb5-2" else {}),
    data = ":" + package + "_data",
    package = package,
    tags = ["manual"],
    version = _VERSION,
) for package in _PACKAGES]

[validate_debian_package(
    name = package + "_validation",
    control = ":" + package + "_metadata",
    control_files = {":" + package + "." + member: member for member in [
        "symbols",
        "shlibs",
        "triggers",
    ]} | ({
        ":libgssapi-krb5-2.postinst": "postinst",
        ":libgssapi-krb5-2.postrm": "postrm",
    } if package == "libgssapi-krb5-2" else {}),
    data = ":" + package + "_data",
    deb = ":" + package.replace("-", "_") + "_deb",
    package = package,
    tags = ["manual"],
    version = _VERSION,
) for package in _PACKAGES]

filegroup(
    name = "package_validation",
    srcs = [":" + package + "_validation" for package in _PACKAGES],
    tags = ["manual"],
)
