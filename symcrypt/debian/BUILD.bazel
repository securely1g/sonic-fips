load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary")
load("@sonic_build_infra//deb:metadata.bzl", "debian_library", "debian_metadata")
load("@sonic_build_infra//deb:sonic_deb.bzl", "sonic_deb")
load("@sonic_build_infra//deb:validation.bzl", "validate_debian_package")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "source_control",
    srcs = ["source_control.py"],
)

genrule(
    name = "owner_control",
    srcs = ["//src/SymCrypt-OpenSSL-Debian/debian:control"],
    outs = [
        "control",
        "changelog",
    ],
    cmd = "$(execpath :source_control) $(location //src/SymCrypt-OpenSSL-Debian/debian:control) $(location control) $(location changelog)",
    tools = [":source_control"],
)

[debian_library(
    name = package + "_library",
    control_tar = "@symcrypt_package_deps//" + package + ":control",
    data = "@symcrypt_package_deps//" + package + ":data",
) for package in [
    "libc6",
    "libgcc-s1",
]]

pkg_tar(
    name = "data",
    deps = ["//symcrypt:runtime"],
)

debian_metadata(
    name = "metadata",
    changelog = ":changelog",
    control = ":control",
    data = ":data",
    dependencies = [
        ":libc6_library",
        ":libgcc-s1_library",
        "//openssl/debian:libssl3t64_library",
    ],
    generate_symbols = True,
    package = "symcrypt-openssl",
    version = "1.11.0",
)

filegroup(
    name = "symbols",
    srcs = [":metadata"],
    output_group = "symbols",
)

# The original owner package has no scripts, conffiles or trigger declaration.
# Keep the sealed runtime bytes unchanged and supply real generated metadata.
sonic_deb(
    name = "symcrypt_openssl_deb",
    control_file = ":metadata",
    control_files = {":symbols": "symbols"},
    data = ":data",
    package = "symcrypt-openssl",
    tags = ["manual"],
    version = "1.11.0",
)

validate_debian_package(
    name = "package_validation",
    control = ":metadata",
    control_files = {":symbols": "symbols"},
    data = ":data",
    deb = ":symcrypt_openssl_deb",
    package = "symcrypt-openssl",
    tags = ["manual"],
    version = "1.11.0",
)
