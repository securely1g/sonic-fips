module(
    name = "sonic-fips",
    version = "0.0.1",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.5")
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.16-72d9705e37d0e83a072cad3eb73b75cd6cc1e4c6", repo_name = "sonic_build_infra")
bazel_dep(name = "tar.bzl", version = "0.10.5-sonic.1")

single_version_override(
    module_name = "rules_cc",
    version = "0.2.20",
)

single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5-sonic.1",
)

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

register_toolchains(
    "@sonic_build_infra//tools/build_tools:make_toolchain",
    "@sonic_build_infra//tools/build_tools:m4_toolchain",
    "@sonic_build_infra//tools/build_tools:pkgconfig_toolchain",
)

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "openssl_deps",
    packages = [
        "libzstd-dev",
        "zlib1g-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "openssl_deps")

openssl_source = use_repo_rule("//openssl:sources.bzl", "openssl_source")

openssl_source(name = "openssl_src")

apt.install(
    dependency_set = "openssh_deps",
    packages = [
        "libaudit-dev",
        "libcbor-dev",
        "libcrypt-dev",
        "libedit-dev",
        "libfido2-dev",
        "libkrb5-dev",
        "libpam0g-dev",
        "libselinux1-dev",
        "libudev-dev",
        "libwrap0-dev",
        "libwtmpdb-dev",
        "zlib1g-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "openssh_deps")

# Select the pinned package's direct CcInfo so source OpenSSL supplies crypto.
use_repo(
    apt,
    fido2_amd64 = "trixie_libfido2-dev-amd64_1.15.0-1-b1",
    fido2_arm64 = "trixie_libfido2-dev-arm64_1.15.0-1-b1",
)

openssh_source = use_repo_rule("//openssh:sources.bzl", "openssh_source")

openssh_source(name = "openssh_src")
