module(
    name = "sonic-fips",
    version = "0.0.2",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.5")
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "rules_gzip", version = "1.0.0")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.17-1f3e526a29e5fc391b42b11925a41889a44aa7a0", repo_name = "sonic_build_infra")
bazel_dep(name = "tar.bzl", version = "0.10.5-sonic.1")

single_version_override(
    module_name = "rules_cc",
    version = "0.2.20",
)

single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5-sonic.1",
)

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc-14.2.0-linux-target-aarch64-host-aarch64", "gcc-14.2.0-linux-target-x86_64-host-x86_64", "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

register_toolchains(
    "@sonic_build_infra//tools/build_tools:make_toolchain",
    "@sonic_build_infra//tools/build_tools:m4_toolchain",
    "@sonic_build_infra//tools/build_tools:pkgconfig_toolchain",
)

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "openssl_deps",
    packages = [
        "libzstd-dev",
        "zlib1g-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "openssl_deps")

openssl_source = use_repo_rule("//openssl:sources.bzl", "openssl_source")

openssl_source(name = "openssl_src")

# Packaging uses the same locked runtime libraries as the compiler inputs.
apt.install(
    dependency_set = "openssl_package_deps",
    packages = [
        "libc6",
        "libzstd1",
        "zlib1g",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "openssl_package_deps")

# Upstream archive extraction in Debian metadata actions.
tar_tools = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
use_repo(tar_tools, "bsd_tar_toolchains")

# Use the same reproducible native gzip configuration as sonic-buildimage.
bazel_dep(name = "pigz", version = "2.8")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "toolchain_utils", version = "1.0.2")

register_toolchains("//tools/bazel/gzip:toolchain")

# Draft producer validation: the reviewed Debian metadata/tool features are
# published together until their individual infrastructure PRs land.
git_override(
    module_name = "sonic-build-infra",
    commit = "38ff19ef6e0216bef4cc7e1b15d0cffe0701794e",
    remote = "https://github.com/securely1g/sonic-build-infra.git",
)
bazel_dep(name = "toolchains_llvm", version = "1.11.2")

sysroots = use_extension("@sonic_build_infra//toolchains/sysroot:extensions.bzl", "sysroots")
sysroots.debian(
    name = "symcrypt_sysroot_amd64",
    architecture = "amd64",
)
sysroots.debian(
    name = "symcrypt_sysroot_arm64",
    architecture = "arm64",
)
use_repo(sysroots, "symcrypt_sysroot_amd64", "symcrypt_sysroot_arm64")

# Core SymCrypt explicitly chooses Clang in the native recipe. Do not register
# it globally: its cmake_variant target selects this toolchain locally.
llvm = use_extension("//symcrypt:toolchain.bzl", "clang")
use_repo(llvm, "symcrypt_llvm")

symcrypt_source = use_repo_rule("//symcrypt:sources.bzl", "symcrypt_source")

symcrypt_source(name = "symcrypt_src")

symcrypt_openssl_source = use_repo_rule("//symcrypt:sources.bzl", "symcrypt_openssl_source")

symcrypt_openssl_source(name = "symcrypt_openssl_src")

pyelftools_source = use_repo_rule("//symcrypt:sources.bzl", "pyelftools_source")

pyelftools_source(name = "symcrypt_pyelftools")
